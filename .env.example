# Required. Server-side only, never exposed to the browser.
OPENAI_API_KEY=

# Optional overrides.
OPENAI_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024

# Longest edge, in pixels, that a reference image is downscaled to before being
# sent to OpenAI. Image input is billed on dimensions and every generated image
# re-sends every reference, so this is the main lever on reference cost.
# Default 768. Range 256-2048. Lower is cheaper, higher preserves finer detail.
REFERENCE_IMAGE_MAX_EDGE=768

# JPEG quality for generated images before they are stored. Default 88, range 40-100.
# Images with transparency stay PNG regardless.
GENERATED_IMAGE_QUALITY=88

# How many days a generated image stays in blob storage before it is swept.
# Default 7, range 1-90. Long enough to import into Shopify later in the week.
HOSTED_IMAGE_TTL_DAYS=7

# Optional. If set, /api/cleanup-expired-images requires this as a bearer token.
# Vercel Cron sends it automatically. Leave unset to allow the in-app sweep.
CRON_SECRET=

# Required for hosting generated images so Shopify can import them from the CSV.
BLOB_READ_WRITE_TOKEN=
